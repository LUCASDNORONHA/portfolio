---
import "../styles/global.css";
const base = import.meta.env.BASE_URL;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Lucas Dias Noronha — Analista de Dados",
  description = "Portfólio profissional de Lucas Dias Noronha, com projetos em análise de dados, visualização, estatística e inteligência de dados.",
  image = "/images/projects/panorama-indigena.png",
  noindex = false,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;

const socialImage = Astro.site
  ? new URL(image, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content="Lucas Dias Noronha"
    />

    <meta
      name="theme-color"
      content="#0B0D10"
    />

    {
      noindex && (
        <meta
          name="robots"
          content="noindex, nofollow"
        />
      )
    }

    {
      canonicalURL && (
        <link
          rel="canonical"
          href={canonicalURL}
        />
      )
    }

    <link
        rel="icon"
        type="image/svg+xml"
        href={`${base}favicon.svg`}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:locale"
      content="pt_BR"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    {
      canonicalURL && (
        <meta
          property="og:url"
          content={canonicalURL}
        />
      )
    }

    {
      socialImage && (
        <meta
          property="og:image"
          content={socialImage}
        />
      )
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {
      socialImage && (
        <meta
          name="twitter:image"
          content={socialImage}
        />
      )
    }
  </head>

  <body>
    <a
      class="skip-link"
      href="#conteudo-principal"
    >
      Ir para o conteúdo principal
    </a>

    <slot />
  </body>
</html>